# Pacotes e extrações locais (não versionar binários sem pedido)
incoming/*
!incoming/.gitkeep
extracted/**
!extracted/.gitkeep
!extracted/REPORT.md
repack/**
!repack/.gitkeep
dist/*
!dist/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Servidor / secrets
server/.env
*.pem

# Theos build artifacts
gate/.theos/
